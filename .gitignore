# TASK-S08 — Sentinel repository ignores

# Build artefacts
build/
dist/
# PyInstaller cannot write into a directory whose exe is running, so rebuilds
# stage into these and are promoted afterwards. See INSTALL.md.
build_new/
dist_new/
*.pyc
*.pyo
__pycache__/

# Virtual environments
.venv*/
venv/

# Logs and runtime debris
*.log
*.tmp
sentinel_err.log
sentinel_out.log
test_event.tmp

# Audit / observation output (runtime data, not source)
audit_logs/
scratch/
watched/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local override configs
.env
.env.local
*.local.json

# Runtime databases and other tools' backups
.mempalace.db
.shadow_engineer_backups/

# pytest
.pytest_cache/
